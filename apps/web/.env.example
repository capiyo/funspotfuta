# Copy to .env.local and fill values from Firebase Console. No real secrets belong in Git.
VITE_API_BASE_URL=https://clash-api-m5mr.onrender.com/api
# Optional override for the shared server-side player headshot resolver
VITE_PLAYER_HEADSHOT_ENDPOINT=/.netlify/functions/player-headshots
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=funzy-d56d7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=funzy-d56d7
VITE_FIREBASE_STORAGE_BUCKET=funzy-d56d7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key
# Public canonical origin is fixed in scripts/generate-crawl-files.mjs; VITE_SITE_URL is intentionally not used.
