# SRS media-plane bind addresses.
# Keep RTMP and SRS HTTP loopback-only. The Nginx edge proxies HLS and only the SRS WebRTC play API.
SRS_RTMP_BIND=127.0.0.1
SRS_HTTP_BIND=127.0.0.1
# WebRTC media uses UDP. Restrict this port with the host firewall.
SRS_RTC_BIND=0.0.0.0
# Replace with the publicly reachable IPv4 address advertised in WebRTC SDP.
SRS_PUBLIC_CANDIDATE=203.0.113.10
# Host listener for the authorization-aware Nginx media edge. Terminate TLS
# at your public load balancer/CDN and forward to this port.
VIDEO_EDGE_BIND=127.0.0.1