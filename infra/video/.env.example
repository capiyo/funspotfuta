# SRS network bindings. Keep HTTP/HLS private behind an authenticated TLS edge.
SRS_RTMP_BIND=127.0.0.1
SRS_HTTP_BIND=127.0.0.1
# WebRTC requires a reachable UDP port; restrict this with firewall rules.
SRS_RTC_BIND=0.0.0.0
SRS_RTC_UDP_PORT=8000

# Set this in the SRS configuration to the externally reachable media IP/DNS.
SRS_PUBLIC_CANDIDATE=replace-with-public-media-ip-or-dns

# Control-plane integration. Keep secrets in deployment secret storage.
FUNSPOT_API_BASE_URL=https://your-api.example
FUNSPOT_VIDEO_INTERNAL_TOKEN=replace-at-deploy-time
FUNSPOT_VIDEO_PUBLIC_ORIGIN=https://funspot.co.ke
FUNSPOT_VIDEO_SIGNING_KEY=replace-at-deploy-time

# Optional TURN for restrictive NAT/mobile networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=