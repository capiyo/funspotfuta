# SRS media-plane bind addresses.
# Keep RTMP and HTTP loopback-only until authorization-aware edge proxying exists.
SRS_RTMP_BIND=127.0.0.1
SRS_HTTP_BIND=127.0.0.1
# WebRTC media uses UDP. Restrict this port with the host firewall.
SRS_RTC_BIND=0.0.0.0
# Publicly reachable IPv4 address advertised in WebRTC SDP.
SRS_PUBLIC_CANDIDATE=203.0.113.10