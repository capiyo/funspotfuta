{
  "name": "funspot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "~18.2.79",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0"
  },
  "scripts": {
    "typecheck:core": "cd packages/core && npx tsc --noEmit",
    "typecheck:web": "cd apps/web && npx tsc --noEmit",
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npm run start",
    "build:web": "cd apps/web && npm run build",
    "lint:web": "cd apps/web && npm run lint",
    "typecheck:mobile": "cd apps/mobile && npx tsc --noEmit",
    "test:core": "vitest run packages/core/src/queries/queryKeys.test.ts",
    "sync:team-crests": "node scripts/sync-team-crests.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "vitest": "^2.1.9"
  }
}
