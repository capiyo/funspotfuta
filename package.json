{
  "name": "funspot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "~18.2.79",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0"
  },
  "scripts": {
    "typecheck:core": "npm run typecheck --workspace=@funspot/core",
    "typecheck:web": "npm run typecheck --workspace=funspot-web 2>/dev/null || cd apps/web && npx tsc --noEmit",
    "dev:web": "npm run dev --workspace=funspot-web",
    "dev:mobile": "npm run start --workspace=funspot-mobile",
    "dev:web:vite": "npm run dev:vite --workspace=funspot-web",
    "build:web:vite": "npm run build:vite --workspace=funspot-web",
    "preview:web:vite": "npm run preview:vite --workspace=funspot-web"
  },
  "devDependencies": {
    "turbo": "^2.10.13"
  }
}
