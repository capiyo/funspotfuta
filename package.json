{
  "name": "funspot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "~18.2.79"
  },
  "scripts": {
    "typecheck:core": "npm run typecheck --workspace=@funspot/core",
    "typecheck:web": "npm run typecheck --workspace=funspot-web 2>/dev/null || cd apps/web && npx tsc --noEmit",
    "dev:web": "npm run dev --workspace=funspot-web",
    "dev:mobile": "npm run start --workspace=funspot-mobile",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "react": "18.2.0",
    "react-native": "0.74.5"
  }
}
